{
  "name": "inv",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3030",
    "start": "vite preview --host --port 3030",
    "build": "npm run typecheck && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lintFix": "npm run lint -- --fix",
    "format": "prettier \"src/**/*.{ts,tsx,scss}\" --write --config ./.prettierrc",
    "formatAndFix": "npm run format && npm run lintFix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview --port 3030",
    "fetch-data": "node scripts/fetch-data.mjs",
    "build-indexes": "node scripts/build-indexes.mjs",
    "fetch-exclusives": "node scripts/fetch-exclusives.mjs",
    "scrape-exclusives": "node scripts/scrape-exclusives.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/query-async-storage-persister": "^5.106.1",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-query-persist-client": "^5.106.1",
    "firebase": "^13.2.0",
    "idb-keyval": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.2.4",
    "sass": "^1.86.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.2.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,scss,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
